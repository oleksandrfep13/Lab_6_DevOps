# Базовий образ: мінімальна версія Python 3.11 на Linux (slim = легка версія без зайвих пакетів)
FROM python:3.11-slim

# Встановлюємо робочу директорію всередині контейнера
# Усі наступні команди будуть виконуватись відносно /app
WORKDIR /app

# Копіюємо файл із залежностями в контейнер
# Робимо це окремо для того, щоб Docker міг кешувати цей шар (layer caching)
# Якщо requirements.txt не змінюється — перевстановлення бібліотек не відбувається
COPY requirements.txt .

# Встановлюємо Python-залежності всередині контейнера
# --no-cache-dir зменшує розмір образу, не зберігаючи кеш pip
RUN pip install --no-cache-dir -r requirements.txt

# Копіюємо весь код проєкту в контейнер
# Після цього в контейнері доступні всі файли застосунку
COPY . .

# Вказуємо порт, який буде використовуватися додатком
# Це інформаційна директива (не відкриває порт автоматично, але документує його)
EXPOSE 8080

# Команда запуску контейнера
# Запускає Flask-додаток через файл run.py
CMD ["python", "run.py"]